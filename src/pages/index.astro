---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "FlyerHannover",
  "legalName": "ProSmi Verlag, Inh. Viktoriya Fradkina",
  "description": "Zuverlässige Flyer- & Prospektverteilung in Hannover und Region. Haushaltswerbung, Auslageverteilung und Promotion ab 1.000 Stück.",
  "url": "https://www.flyerhannover.de",
  "telephone": "+4951110568928",
  "email": "info@flyer-verteilt.de",
  "image": "https://www.flyerhannover.de/logo-prosmi.png",
  "priceRange": "€€",
  "areaServed": {
    "@type": "City",
    "name": "Hannover"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Dessauer Str. 14",
    "postalCode": "30161",
    "addressLocality": "Hannover",
    "addressRegion": "Niedersachsen",
    "addressCountry": "DE"
  },
  "sameAs": []
};
---

<Layout
  title="FlyerHannover | Flyer- & Prospektverteilung in Hannover"
  description="Zuverlässige Flyer- & Prospektverteilung in Hannover und Region. Haushaltswerbung, Auslageverteilung und Promotion ab 1.000 Stück."
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <Header />

  <main>
    <!-- Hero Section -->
    <section id="home" class="pt-28 pb-20 bg-gradient-to-b from-blue-50 to-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          
          <!-- Left content -->
          <div>
            <p class="text-blue-600 font-medium mb-3">
              Ihr Partner für Werbung in Hannover
            </p>
            <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 leading-tight mb-6">
              Zuverlässige Flyer- & Prospektverteilung in Hannover und Region
            </h1>
            <p class="text-lg text-slate-600 mb-8 leading-relaxed">
              Haushaltswerbung, Auslageverteilung und Promotion — wir bringen Ihre Werbung direkt zur Zielgruppe. Flexibel ab 1.000 Stück, mit Qualitätskontrolle auf jedem Schritt.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="#kontakt"
                class="inline-flex items-center justify-center px-6 py-3 bg-amber-500 text-slate-900 font-semibold rounded-lg hover:bg-amber-600 transition-colors shadow-sm"
              >
                Kostenlose Anfrage
              </a>
              <a
                href="#leistungen"
                class="inline-flex items-center justify-center px-6 py-3 bg-white text-blue-700 font-medium rounded-lg border border-blue-200 hover:bg-blue-50 transition-colors"
              >
                Unsere Leistungen
              </a>
            </div>
          </div>

          <!-- Right side - Info card -->
          <div class="hidden lg:block">
            <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-8">
              <div class="space-y-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl shrink-0">
                    📍
                  </div>
                  <div>
                    <h3 class="font-semibold text-slate-900">Lokal in Hannover</h3>
                    <p class="text-slate-600 text-sm mt-1">Verteilung in der Stadt und umliegenden Regionen</p>
                  </div>
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center text-2xl shrink-0">
                    ✓
                  </div>
                  <div>
                    <h3 class="font-semibold text-slate-900">Ab 1.000 Stück</h3>
                    <p class="text-slate-600 text-sm mt-1">Flexible Auftragsgrößen, auch kleine Mengen möglich</p>
                  </div>
                </div>
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl shrink-0">
                    🛡️
                  </div>
                  <div>
                    <h3 class="font-semibold text-slate-900">Qualitätskontrolle</h3>
                    <p class="text-slate-600 text-sm mt-1">Prüfung auf jedem Schritt der Verteilung</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
    <!-- Leistungen Section -->
    <section id="leistungen" class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            Unsere Leistungen
          </h2>
          <p class="text-slate-600 text-lg">
            Von der klassischen Haushaltswerbung bis zur gezielten Promotion — wir bieten flexible Lösungen für Ihre Werbekampagne in Hannover und Umgebung.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Card 1 -->
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100 hover:border-blue-200 hover:shadow-md transition-all">
            <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl mb-5">
              📬
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">Haushaltswerbung</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Adresslose Verteilung von Flyern und Prospekten in Briefkästen — flächendeckend und zielgerichtet.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100 hover:border-blue-200 hover:shadow-md transition-all">
            <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center text-2xl mb-5">
              🏪
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">Auslageverteilung</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Platzierung Ihrer Werbematerialien in Geschäften, Praxen, Cafés und öffentlichen Einrichtungen.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100 hover:border-blue-200 hover:shadow-md transition-all">
            <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl mb-5">
              📢
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">Promotion</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Aktive und adressierte Verteilung durch Promoter — ideal für Aktionen und Veranstaltungen.
            </p>
          </div>

          <!-- Card 4 -->
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100 hover:border-blue-200 hover:shadow-md transition-all">
            <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl mb-5">
              📰
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">Zeitungszustellung</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Zuverlässige Zustellung von Zeitungen und Magazinen in ausgewählten Gebieten.
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- Über uns Section -->
    <section id="ueber-uns" class="py-20 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">
              Über uns
            </h2>
            <p class="text-slate-600 text-lg leading-relaxed mb-6">
              Wir sind Ihr lokaler Partner für die Verteilung von Werbematerialien in Hannover und der Region Niedersachsen. Mit langjähriger Erfahrung und einem eingespielten Team sorgen wir dafür, dass Ihre Flyer, Prospekte und Kataloge zuverlässig bei der Zielgruppe ankommen.
            </p>
            <p class="text-slate-600 text-lg leading-relaxed mb-8">
              Ob Haushaltswerbung, Auslage in Geschäften oder aktive Promotion — wir bieten flexible Lösungen ab 1.000 Stück und begleiten Sie von der Planung bis zur Qualitätskontrolle.
            </p>

            <div class="grid sm:grid-cols-2 gap-4">
              <div class="bg-white rounded-xl p-5 border border-slate-100">
                <div class="text-2xl font-bold text-blue-600 mb-1">Lokal</div>
                <p class="text-sm text-slate-600">Hannover & Umgebung</p>
              </div>
              <div class="bg-white rounded-xl p-5 border border-slate-100">
                <div class="text-2xl font-bold text-blue-600 mb-1">Flexibel</div>
                <p class="text-sm text-slate-600">Ab 1.000 Stück möglich</p>
              </div>
              <div class="bg-white rounded-xl p-5 border border-slate-100">
                <div class="text-2xl font-bold text-blue-600 mb-1">Zuverlässig</div>
                <p class="text-sm text-slate-600">Qualitätskontrolle inklusive</p>
              </div>
              <div class="bg-white rounded-xl p-5 border border-slate-100">
                <div class="text-2xl font-bold text-blue-600 mb-1">Persönlich</div>
                <p class="text-sm text-slate-600">Direkte Beratung vor Ort</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8">
            <h3 class="text-xl font-semibold text-slate-900 mb-4">So arbeiten wir</h3>
            <ol class="space-y-4">
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">1</span>
                <div>
                  <p class="font-medium text-slate-900">Anfrage & Beratung</p>
                  <p class="text-sm text-slate-600">Sie schildern Ihr Vorhaben — wir beraten zu Gebieten und Mengen.</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">2</span>
                <div>
                  <p class="font-medium text-slate-900">Planung</p>
                  <p class="text-sm text-slate-600">Gemeinsam legen wir Verteilgebiete und Termin fest.</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">3</span>
                <div>
                  <p class="font-medium text-slate-900">Durchführung</p>
                  <p class="text-sm text-slate-600">Unsere Teams verteilen Ihre Materialien zuverlässig.</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">4</span>
                <div>
                  <p class="font-medium text-slate-900">Kontrolle & Feedback</p>
                  <p class="text-sm text-slate-600">Sie erhalten eine Rückmeldung zur durchgeführten Verteilung.</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>
    <!-- Kontakt Section -->
    <section id="kontakt" class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            Kontakt
          </h2>
          <p class="text-slate-600 text-lg">
            Haben Sie Fragen oder möchten Sie ein Angebot?
          </p>
          <p class="text-slate-600 text-lg">
            Schreiben Sie uns — wir melden uns schnellstmöglich.
          </p>
        </div>

        <div class="grid lg:grid-cols-5 gap-10">
	<!-- Contact info -->
          <div class="lg:col-span-2 space-y-6">
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">E-Mail</h3>
              <a href="mailto:info@flyer-verteilt.de" class="text-blue-600 hover:underline">
                info@flyer-verteilt.de
              </a>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">Telefon</h3>
              <a href="tel:+4951110568928" class="text-blue-600 hover:underline">
                +49 511 105 68 928
              </a>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">WhatsApp</h3>
              <a
                href="https://wa.me/4951110568928"
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-600 hover:underline"
              >
                +49 511 105 68 928
              </a>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">Fax</h3>
              <p class="text-slate-600 text-sm">0511 - 897 659 54</p>
            </div>
          </div>
          <!-- Form -->
          <div class="lg:col-span-3">
            <form 
  id="contact-form"
  action="https://api.web3forms.com/submit" 
  method="POST" 
  class="bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-100 space-y-5"
>
  <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="Neue Anfrage von FlyerHannover Website" />
  <input type="hidden" name="from_name" value="FlyerHannover Website" />

  <!-- Honeypot: спам-защита Web3Forms. Обычные пользователи это поле не видят и не заполняют. -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

  <!-- Сообщение об успехе (скрыто по умолчанию) -->
  <div id="form-success" class="hidden p-4 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm">
    Vielen Dank! Ihre Anfrage wurde erfolgreich gesendet. Wir melden uns in Kürze.
  </div>

  <div id="form-fields" class="space-y-5">
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label for="name" class="block text-sm font-medium text-slate-700 mb-1.5">Name *</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
          placeholder="Ihr Name"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">E-Mail *</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
          placeholder="ihre@email.de"
        />
      </div>
    </div>

    <div>
      <label for="phone" class="block text-sm font-medium text-slate-700 mb-1.5">Telefon</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
        placeholder="Ihre Telefonnummer"
      />
    </div>

    <div>
      <label for="message" class="block text-sm font-medium text-slate-700 mb-1.5">Nachricht *</label>
      <textarea
        id="message"
        name="message"
        required
        rows="4"
        class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"
        placeholder="Beschreiben Sie kurz Ihr Anliegen..."
      ></textarea>
    </div>

    <!-- GDPR Checkbox -->
    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="privacy"
        name="privacy"
        required
        class="mt-1 w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500"
      />
      <label for="privacy" class="text-sm text-slate-600 leading-relaxed">
        Ich habe die <a href="/datenschutz" class="text-blue-600 hover:underline">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zur Bearbeitung der Anfrage zu. *
      </label>
    </div>

    <button
      type="submit"
      id="submit-btn"
      class="w-full sm:w-auto px-8 py-3 bg-amber-500 text-slate-900 font-semibold rounded-lg hover:bg-amber-600 transition-colors"
    >
      Anfrage absenden
    </button>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');
  const formFields = document.getElementById('form-fields');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Wird gesendet...';

    const formData = new FormData(form);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (result.success) {
        formFields?.classList.add('hidden');
        successMsg?.classList.remove('hidden');
        form.reset();
      } else {
        alert('Fehler beim Senden. Bitte versuchen Sie es erneut.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Anfrage absenden';
      }
    } catch (error) {
      alert('Fehler beim Senden. Bitte versuchen Sie es erneut.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Anfrage absenden';
    }
  });
</script>
          </div>
        </div>
      </div>
    </section>
     <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-8 text-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row justify-between items-center gap-4">
        <p>© {new Date().getFullYear()} FlyerHannover. Alle Rechte vorbehalten.</p>
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/impressum" class="hover:text-white transition-colors">Impressum</a>
          <a href="/datenschutz" class="hover:text-white transition-colors">Datenschutz</a>
          <a href="/agb" class="hover:text-white transition-colors">AGB</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>
