---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Flyerverteilung Hannover | Verteilservice Nord" } = Astro.props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Zuverlässige Flyer- und Prospektverteilung in Hannover und Region. Haushaltswerbung, Auslageverteilung und Promotion." />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-blue-600 selection:text-white">
    <slot />
  </body>
</html>
